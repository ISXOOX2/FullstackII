<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM principal (agregador): agrupa los 3 microservicios para abrirlos juntos en IntelliJ
  (File > Open sobre esta carpeta) y compilarlos todos con un solo comando: mvn package
  Cada microservicio sigue siendo un proyecto Spring Boot independiente, con su propio pom.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cl.foreverink</groupId>
    <artifactId>forever-ink-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Forever Ink · Backend</name>
    <description>Microservicios Spring Boot de Forever Ink: ms-auth, ms-catalogo y ms-reservas.</description>

    <modules>
        <module>ms-auth</module>
        <module>ms-catalogo</module>
        <module>ms-reservas</module>
    </modules>
</project>
