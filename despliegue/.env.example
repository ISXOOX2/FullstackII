# Copia este archivo como .env en la raíz del proyecto (junto a docker-compose.yml) y cambia los valores.
# NO subas el .env a GitHub (ya está en .gitignore).

# Contraseña del usuario root de MySQL
DB_PASSWORD=cambia-esta-clave

# Clave para firmar los tokens JWT (mínimo 32 caracteres, la misma para los 3 microservicios)
JWT_SECRETO=escribe-aqui-una-frase-larga-y-secreta-de-32-o-mas-caracteres

# Contraseñas de las cuentas iniciales del sistema (OBLIGATORIAS para el administrador y el vendedor).
# Entre 4 y 10 caracteres, con letras y números (ej: Tinta#2026). No uses las de ejemplo del repositorio.
ADMIN_PASSWORD=
VENDEDOR_PASSWORD=
# Opcional: cuenta de cliente de prueba (si queda vacía, usa la de ejemplo)
CLIENTE_PASSWORD=

# Dirección pública del sitio (para CORS). En EC2: http://TU-IP-PUBLICA
CORS_ORIGENES=http://localhost
