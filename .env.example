# Copia este archivo como .env y ajusta los valores.
# Vite solo lee las variables que empiezan con VITE_.

# false = usa la base de datos simulada (data/db.js). true = usa el backend con axios.
VITE_USAR_API=false

# Dirección de cada microservicio. En AWS, con Nginx en el mismo dominio, basta con las rutas relativas.
# En local, con Spring Boot corriendo en tu computador, por ejemplo:
#   VITE_API_USUARIOS=http://localhost:8081/api/v1/usuarios
VITE_API_USUARIOS=/api/v1/usuarios
VITE_API_CATALOGO=/api/v1/catalogo
VITE_API_RESERVAS=/api/v1/reservas
VITE_API_BLOG=/api/v1/blog
