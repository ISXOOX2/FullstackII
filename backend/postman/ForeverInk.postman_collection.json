{
  "info": {
    "name": "Forever Ink · Microservicios",
    "description": "Pruebas de los 3 microservicios (producto 8081, usuario 8082, carrito 8083). Ejecutar primero '1. Login admin' para guardar el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "usuario-service (8082)",
      "item": [
        {
          "name": "1. Login admin (200 + token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8082/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin.foreverink@gmail.com\",\n  \"password\": \"Admin#123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login incorrecto (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8082/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin.foreverink@gmail.com\",\n  \"password\": \"mala\"\n}"
            }
          }
        },
        {
          "name": "3. Registro cliente (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8082/api/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run\": \"111111111\",\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Pérez Soto\",\n  \"correo\": \"ana.perez@gmail.com\",\n  \"password\": \"Ana#1234\",\n  \"fechaNacimiento\": \"2000-05-10\",\n  \"region\": \"Región Metropolitana\",\n  \"comuna\": \"Santiago\",\n  \"direccion\": \"Av. Siempre Viva 123\"\n}"
            }
          }
        },
        {
          "name": "4. Registro con datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8082/api/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run\": \"123\",\n  \"nombre\": \"\",\n  \"correo\": \"ana@hotmail.com\",\n  \"password\": \"1\"\n}"
            }
          }
        },
        {
          "name": "5. Mis datos (200, requiere token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8082/api/usuarios/me"
          }
        },
        {
          "name": "6. Listar usuarios (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8082/api/usuarios"
          }
        },
        {
          "name": "7. Listar usuarios sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8082/api/usuarios"
          }
        }
      ]
    },
    {
      "name": "producto-service (8081)",
      "item": [
        {
          "name": "1. Listar productos (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8081/api/productos"
          }
        },
        {
          "name": "2. Solo ofertas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8081/api/productos?soloOfertas=true"
          }
        },
        {
          "name": "3. Un producto (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8081/api/productos/1"
          }
        },
        {
          "name": "4. Producto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8081/api/productos/9999"
          }
        },
        {
          "name": "5. Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8081/api/categorias"
          }
        },
        {
          "name": "6. Crear producto (201, ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"FI-TEST\",\n  \"nombre\": \"Diseño de prueba\",\n  \"descripcion\": \"Creado desde Postman\",\n  \"precio\": 45000,\n  \"stock\": 5,\n  \"stockCritico\": 2,\n  \"categoriaId\": 1,\n  \"imagenes\": []\n}"
            }
          }
        },
        {
          "name": "7. Crear producto sin token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8081/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin permiso\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "carrito-service (8083)",
      "item": [
        {
          "name": "1. Ver carrito (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8083/api/carritos/postman-demo"
          }
        },
        {
          "name": "2. Agregar ítem (201, consulta producto-service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8083/api/carritos/postman-demo/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}"
            }
          }
        },
        {
          "name": "3. Cambiar cantidad (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8083/api/carritos/postman-demo/items/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 3\n}"
            }
          }
        },
        {
          "name": "4. Más de 5 unidades (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8083/api/carritos/postman-demo/items/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 9\n}"
            }
          }
        },
        {
          "name": "5. Producto inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8083/api/carritos/postman-demo/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 9999,\n  \"cantidad\": 1\n}"
            }
          }
        },
        {
          "name": "6. Quitar ítem (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:8083/api/carritos/postman-demo/items/1"
          }
        },
        {
          "name": "7. Vaciar carrito (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:8083/api/carritos/postman-demo"
          }
        }
      ]
    }
  ]
}